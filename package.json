{
  "name": "iagentics-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "video": "remotion studio",
    "video:render": "remotion render abertura-marca out/abertura-marca.mp4",
    "video:render:vertical": "remotion render abertura-marca-vertical out/abertura-marca-vertical.mp4",
    "video:render:banner": "remotion render banner-boasvindas public/plataforma/banner-boasvindas-v2.mp4",
    "video:still:og": "remotion still og-certificado public/plataforma/og-certificado-v1.jpg",
    "test:unit": "vitest run",
    "test:integracao": "vitest run lib/plataforma/autorizacao.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:email": "rm -f /tmp/iagentics-e2e-emails.jsonl && playwright test -c playwright.email.config.ts",
    "db:local": "node scripts/db-local.mjs start",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:migrar": "node scripts/migrar.mjs",
    "db:gerar": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@remotion/google-fonts": "^4.0.508",
    "@remotion/player": "^4.0.508",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.13.0",
    "motion": "^12.23.12",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.508",
    "server-only": "^0.0.1",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.508",
    "@remotion/tailwind-v4": "^4.0.508",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
